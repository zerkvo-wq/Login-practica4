

{
  "inputs": [
    {
      "type": "promptString",
      "id": "stitch-key",
      "description": "API key de Google Stitch",
      "password": true
    }
  ],
  "servers": {
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${input:stitch-key}"
      }
    }
  }
}